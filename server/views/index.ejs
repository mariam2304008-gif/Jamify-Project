
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jamify - Rate the Music You Love</title>
  <link rel="stylesheet" href="/CSS/index.css">
  <link rel="stylesheet" href="/CSS/navbar.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="container">
    <h1>Rate. Review. Share.</h1>
    <p class="subtitle">Jamify is a simple music rating app where you can review albums, like reviews, and suggest new music to add.</p>

    <div class="container">
      <h1>Discover New Music</h1>
      <p class="subtitle">Trending reviews and top-rated albums on Jamify.</p>
  
      <div class="album-discovery-grid">
          
        <% albums.forEach(album => { %>
          
          <a href="/albums/<%= album._id %>" class="album-card">
              <div class="album-image-wrapper">
                  <img src="<%= album.coverImageUrl %>" alt="<%= album.title %>">
                  
                  <span class="avg-rating"><i class="fa-solid fa-star"></i> 5.0</span>
              </div>
              <div class="album-card-info">
                  <h3><%= album.title %></h3>
                  <p><%= album.artist %></p>
              </div>
          </a>
  
        <% }) %> 
      </div>
    

<h2 class="section-title" style="margin-top: 40px; margin-bottom: 20px;">Standalone Singles</h2>

<div class="album-discovery-grid"> 
    <% if (typeof standaloneSongs !== 'undefined' && standaloneSongs.length > 0) { %>
        <% standaloneSongs.forEach(song => { %>
                  
            <% const cardUrl = `/songs/${song._id}`; %>

            <a href="<%= cardUrl %>" class="album-card">
                <div class="album-image-wrapper">
                    <img src="<%= song.coverImageUrl || '/Images/album-profile-images/default-single.png' %>" alt="<%= song.title %>">
                    <span class="avg-rating"><i class="fa-solid fa-star"></i> 5.0</span>
                </div>
                <div class="album-card-info">
                    <h3><%= song.title %></h3>
                    <p>
                        <%= Array.isArray(song.artists) ? song.artists.join(', ') : (song.artist || 'Unknown Artist') %>
                    </p>
                </div>
            </a>
    
        <% }) %>
    <% } else { %>
        <p style="color: grey; padding-left: 15px; grid-column: 1 / -1;">No standalone singles available right now.</p>
    <% } %>
</div>
        


    </div>
  </div>

</body>
</html>