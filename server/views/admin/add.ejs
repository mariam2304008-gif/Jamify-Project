<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Add – Jamify</title>
  <link rel="stylesheet" href="/CSS/navbar.css">
  <link rel="stylesheet" href="/CSS/adminadd.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css">
  
</head>
<body>
<%- include('../partials/navbar') %>

<div class="has-navbar">
    </div>

<div class="container">
  <h1>Add Song / Album</h1>

  <% if (error) { %>
    <p style="color:#e74c3c; margin-bottom:12px;"><%= error %></p>
  <% } %>
  <% if (success) { %>
    <p style="color:green; margin-bottom:12px;">Added successfully!</p>
  <% } %>

  <div class="admin-form">
    <form method="POST" action="/admin/add" enctype="multipart/form-data" onsubmit="return validateAdminForm()">

      <% if (prefill) { %>
        <input type="hidden" name="suggestionId" value="<%= prefill._id %>" />
      <% } %>

      <div class="form-row">
        <label>Type *</label>
        <div class="radio-group">
          <label><input type="radio" name="type" value="album" <%= (!prefill || prefill.type === 'album') ? 'checked' : '' %> onclick="updateForm('album')" /> Album</label>
          <label><input type="radio" name="type" value="song"  <%= (prefill && prefill.type === 'song') ? 'checked' : '' %> onclick="updateForm('song')" /> Song</label>
        </div>
      </div>

      <div class="form-row">
        <label>Title *</label>
        <input type="text" name="title" placeholder="Title" value="<%= prefill ? prefill.title : '' %>" required />
      </div>

      <div class="form-row">
        <label>Artist *</label>
        <select name="artist" required style="width:100%; padding:9px 12px; background:#ccc9c6; border:none; border-bottom:1.5px solid #aaa; font-size:14px; color:#444; box-sizing:border-box; outline:none;">
        <option value="">-- Select Artist --</option>
        <% albums_artists.forEach(a => { %>
        <option value="<%= a._id %>" <%= prefill && prefill.artist === a.name ? 'selected' : '' %>><%= a.name %></option>
        <% }) %>
        </select>
      </div>

      <div class="form-row" id="albumField" style="display:none;">
        <label>Belongs to Album <span style="color:#888; font-weight:normal;">(optional)</span></label>
        <select name="albumId" id="albumSelect" onchange="updateImageRequired()">
          <option value="">-- Standalone Single --</option>
          <% albums.forEach(a => { %>
            <option value="<%= a._id %>"><%= a.title %> — <%= a.artist %></option>
          <% }) %>
        </select>
      </div>

      <div class="form-row" id="trackNumberField" style="display:none;">
        <label>Track Number <span style="color:#888; font-weight:normal;">(optional)</span></label>
        <input type="number" name="trackNumber" id="trackNumber" placeholder="e.g. 3" min="1" />
      </div>

      <div class="form-row two-col">
        <div>
          <label>Release Date</label>
          <input type="date" name="releaseDate" value="<%= prefill && prefill.year ? prefill.year + '-01-01' : '' %>" />
        </div>
        <div>
          <label>Genre</label>
          <input type="text" name="genre" placeholder="Pop, Jazz, R&B..." value="<%= prefill ? prefill.genre : '' %>" />
        </div>
      </div>

      <div class="form-row two-col">
        <div>
          <label>Spotify Link</label>
          <input type="text" name="spotifyLink" id="spotifyLink" placeholder="https://open.spotify.com/..." value="<%= prefill ? prefill.link : '' %>" />
        </div>
        <div>
          <label>Anghami Link</label>
          <input type="text" name="anghamiLink" id="anghamiLink" placeholder="https://play.anghami.com/..." />
        </div>
      </div>
      <small id="link-error" style="color:#e74c3c; display:none;">At least one link (Spotify or Anghami) is required.</small>

      <div class="form-row" id="imageField">
        <label id="imageLabel"><%= (prefill && prefill.type === 'song') ? 'Song Cover Image *' : 'Album Cover Image *' %></label>
        <input type="file" name="image" id="imageInput" accept="image/jpeg,image/png,image/gif,image/webp" required />
        <small style="color:#888; display:block; margin-top:4px;">JPG, PNG, GIF or WebP — max 5 MB. Leave empty if adding a track (inherits album cover).</small>
      </div>

      <button type="submit" class="btn-add">Add</button>
    </form>
  </div>
  <h2 style="margin-top: 40px;">Add New Artist</h2>
<div class="admin-form">
  <form method="POST" action="/artists" enctype="multipart/form-data">

    <div class="form-row">
      <label>Name *</label>
      <input type="text" name="name" placeholder="Artist name" required />
    </div>

    <div class="form-row">
      <label>Bio</label>
      <textarea name="bio" rows="3" placeholder="Short bio..." style="width:100%; padding:9px 12px; background:#ccc9c6; border:none; border-bottom:1.5px solid #aaa; font-size:14px; color:#444; box-sizing:border-box; outline:none; resize:vertical; font-family:inherit;"></textarea>
    </div>

    <div class="form-row two-col">
      <div>
        <label>Genre</label>
        <input type="text" name="genre" placeholder="Pop, Rock..." />
      </div>
      <div>
        <label>Country</label>
        <input type="text" name="country" placeholder="e.g. Egypt" />
      </div>
    </div>

    <div class="form-row">
      <label>Spotify URL</label>
      <input type="text" name="spotifyUrl" placeholder="https://open.spotify.com/artist/..." />
    </div>

    <div class="form-row">
      <label>Artist Photo</label>
      <input type="file" name="image" accept="image/jpeg,image/png,image/gif,image/webp" />
      <small style="color:#888; display:block; margin-top:4px;">Leave empty to use default photo</small>
    </div>

    <button type="submit" class="btn-add">Add Artist</button>
  </form>
</div>

</div>

<script src="/JavaScript/navbar.js"></script>
<script src="/JavaScript/adminAdd.js"></script>
</body>
</html>
