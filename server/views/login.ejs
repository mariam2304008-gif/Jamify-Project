<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jamify Music Rating Website</title>
    
    <script src="/JavaScript/toast.js" defer></script>
    <script src="/JavaScript/loginJS.js" defer></script>
    <link rel="stylesheet" href="/CSS/loginCSS.css">
    <link rel="stylesheet" href="/CSS/navbar.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css">
    <script src="/JavaScript/navbar.js" defer></script>
</head>

<body>

    <%- include('partials/navbar') %>
    <div class="has-navbar">
    </div>


<div class="container">
    <div class="header">
        <div class="logo">Jamify</div>
        <div class="subtitle">Rate and review your favorite pop albums</div>
    </div>

    <div class="button-container">
        <button id="loginTab" class="active">Login</button>
        <button id="signupTab">Sign Up</button>
    </div>

    <div id="loginForm" class="form-box">
        <h3>Login</h3>
        <p class="form-desc">Enter your credentials to access your account</p>
        
        <% if (locals.errorMessage) { %>
            <div class="error-message"><%= errorMessage %></div>
        <% } %>
    <form id="loginFormEl" onsubmit="handleLogin(event)">
        <label for="login-user">Username</label>
        <input type="text" id="login-user" name="username">
    
        <label for="login-pass">Password</label>
        <input type="password" id="login-pass" name="password">
    
        <button type="submit" class="submit-btn">Login</button>
    </form>
    </div>

    <div id="signupForm" class="form-box hidden">
        <h3>Sign Up</h3>
        <p class="form-desc">Create a new account to start reviewing music</p>
        
       <form id="signupFormEl" onsubmit="handleSignup(event)">
            <label for="reg-name">Display Name</label>
            <input type="text" id="reg-name" name="displayName">
            
            <label for="reg-user">Username</label>
            <input type="text" id="reg-user" name="username">
            
            <label for="reg-email">Email Address</label>
            <input type="text" id="reg-email" name="email">

            <label for="reg-pass">Password</label>
            <input type="password" id="reg-pass" name="password" placeholder="Min 8 chars, 1 uppercase, 1 number, 1 special">
            
            <label for="reg-confirm">Confirm Password</label>
            <input type="password" id="reg-confirm" name="confirmPassword" placeholder="Re-enter password">
            
            <button type="submit" class="submit-btn">Create Account</button>
        </form>
    </div>
</div>

</body>
</html>