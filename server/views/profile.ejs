<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jamify Profile</title>
    <link rel="stylesheet" href="CSS/profile.css">
    <script src="JavaScript/navbar.js"></script>
</head>
<body>

 <%- include('partials/navbar') %>

<!-- Main content wrapper -->
<div class="main-content">

<!-- Profile Card -->
<div class="profile-card">
    <img id="profileImg" src="Images/album-profile-images/epic.png" class="profile-img">

    <div class="profile-info">
        <h2 id="displayName" class="editable-text" contenteditable="false"></h2>
        <p class="username" id="displayUsername"></p>
        <p class="bio" id="displayBio" class="editable-text" contenteditable="false"></p>

        <div class="stats">
            <span id="statReviews">0 Reviews</span>
            <span id="statPlaylists">0 Playlists</span>
        </div>

        <div class="edit-buttons" id="editButtons" style="display: none;">
            <button id="saveBtn">Save</button>
            <button id="cancelBtn">Cancel</button>
        </div>
        <button id="editBtn">Edit Profile</button>
    </div>
</div>

<!-- Tabs -->
<div class="tabs">
    <button class="tab active" onclick="showTab('reviews', this)">Reviews</button>
    <button class="tab" onclick="showTab('playlists', this)">Playlists</button>
</div>

<!-- Reviews Tab -->
<div id="reviews" class="tab-content active">
    <div id="user-reviews-container"></div>
</div>

<!-- Playlists Tab -->
<div id="playlists" class="tab-content">

    <div class="playlist-header">
        <h3>My Playlists</h3>
        <button id="createPlaylistBtn">+ New Playlist</button>
    </div>

    <div id="user-playlists-container"></div>

    <!-- Create/Edit Playlist Modal -->
    <div class="modal" id="playlistModal">
        <div class="modal-content">
            <h3 id="modalTitle">Create Playlist</h3>
            <input type="text" id="playlistName" placeholder="Playlist name" maxlength="100">
            <textarea id="playlistDesc" placeholder="Description (optional)" maxlength="300" rows="3"></textarea>
            <label class="checkbox-label">
                <input type="checkbox" id="playlistPublic" checked> Public
            </label>
            <div class="modal-buttons">
                <button id="savePlaylistBtn">Save</button>
                <button id="cancelPlaylistBtn" class="btn-secondary">Cancel</button>
            </div>
        </div>
    </div>

</div>

<script src="JavaScript/profile.js"></script>
</div><!-- End main-content -->
</body>
</html>
