<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Jamify Profile</title>
    <link rel="stylesheet" href="/CSS/profile.css">
    <link rel="stylesheet" href="/CSS/navbar.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css">

</head>
<body>

<%- include('partials/navbar') %>

<div class="has-navbar">
    </div>

<div class="main-content">

    <div class="profile-card">
        

       
<div class="profile-image-section">

    
    <img
    src="<%= user.profileImageUrl || '/Images/default-avatar.png' %>"
    alt="Profile"
    class="profile-image"
    id="profileImage"
    onclick="openProfileModal()"
>


    <form
        action="/api/users/profile/photo"
        method="POST"
        enctype="multipart/form-data"
        class="photo-form"
    >

        <input 
        type="file" 
        name="profilePhoto"
            id="profileImageInput"
            accept="image/*"
            hidden
            onchange="this.form.submit()"
        >

        <button
            type="button"
            class="edit-photo-btn"
            onclick="document.getElementById('profileImageInput').click()"
        >
            Edit Photo
        </button>

    </form>

</div>



        <div class="profile-info">
            <h2 id="displayName" class="editable-text" contenteditable="false"><%= user.displayName %></h2>
            <p class="username" id="displayUsername"><%= user.username %></p>
            <p class="bio" id="displayBio" class="editable-text" contenteditable="false"><%= user.bio %></p>

            <div class="stats">
                <span id="statReviews"><%= reviewCount %> Reviews</span>
                <span id="statPlaylists"><%= playlistCount %> Playlists</span>
            </div>

            <div class="edit-buttons" id="editButtons" style="display: none;">
                <button id="saveBtn">Save</button>
                <button id="cancelBtn">Cancel</button>
            </div>
            <button id="editBtn">Edit Profile</button>
        </div>
    </div>

    <div class="profile-layout">
        
        <div class="profile-main-col">
            <div class="tabs">
                <button class="tab active" onclick="showTab('reviews', this)">Reviews</button>
                <button class="tab" onclick="showTab('playlists', this)">Playlists</button>
            </div>

            <div id="reviews" class="tab-content active">
                <div id="user-reviews-container">
                <% if (!reviews || reviews.length === 0) { %>
                    <p class="empty-msg">No reviews yet.</p>
                <% } else { %>
                    <% reviews.forEach(review => { %>
                        <div class="review-card">
                            <% if (review.albumID) { %>
                                <a href="/albums/<%= review.albumID._id %>">
                                    <img src="<%= review.albumID.coverImageUrl ? review.albumID.coverImageUrl : '/Images/default-album.png' %>" alt="album art">
                                </a>
                            <% } else if (review.songID) { %>
                                <a href="/songs/<%= review.songID._id %>">
                                    <img src="<%= review.songID.coverImageUrl || '/Images/album-profile-images/epic.png' %>" alt="song art">
                                </a>
                            <% } else { %>
                                <img src="/Images/default-album.png" alt="fallback art">
                            <% } %>

                            <div class="review-text">
                                <h3>
                                    <% if (review.albumID) { %>
                                        <span style="font-size: 12px; color: #1db954; text-transform: uppercase; display: block; font-weight: bold;">Album Review</span>
                                        <a href="/albums/<%= review.albumID._id %>"><%= review.albumID.title %></a>
                                    <% } else if (review.songID) { %>
                                        <span style="font-size: 12px; color: #1db954; text-transform: uppercase; display: block; font-weight: bold;">Song Review</span>
                                        <a href="/songs/<%= review.songID._id %>"><%= review.songID.title %></a>
                                    <% } else { %>
                                        Unknown Logged Asset
                                    <% } %>
                                </h3>

                                <p class="rating">
                                <% for(let i = 0; i < review.rating; i++) { %>
                                        <i class="fa-solid fa-star"></i>
                                    <% } %>
                                    <% for(let i = review.rating; i < 5; i++) { %>
                                        <i class="fa-regular fa-star" style="color: #ccc"></i>
                                    <% } %>
                                </p>
                                
                                <p><%= review.review %></p>
                                <small><%= new Date(review.date).toLocaleDateString() %> • <%= review.date.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
                </div>
            </div>

            <div id="playlists" class="tab-content">
                <div class="playlist-header">
                    <h3>My Playlists</h3>
                    <button id="createPlaylistBtn">+ New Playlist</button>
                </div>
                <div id="user-playlists-container"></div>
            </div>
        </div>

        <div class="profile-side-col">
            
            <div class="social-widget-card">
                <div class="social-widget-header">
                    <h3>Followers (<%= user.followers ? user.followers.length : 0 %>)</h3>
                    <% if (user.followers && user.followers.length > 3) { %>
                        <button class="toggle-expansion-btn" onclick="toggleSocialExpansion('followersList', this)">Show More</button>
                    <% } %>
                </div>
                <div class="social-connections-list" id="followersList">
                    <% if (!user.followers || user.followers.length === 0) { %>
                        <p class="empty-msg" style="font-size: 12px; text-align: left;">No followers yet.</p>
                    <% } else { %>
                        <% user.followers.forEach((f, index) => { %>
                            <a href="/api/users/<%= f._id %>/public" class="connection-row <%= index >= 3 ? 'collapsible-target' : '' %>">
                                <img src="<%= f.profileImageUrl || '/Images/album-profile-images/epic.png' %>" class="connection-avatar">
                                <div class="connection-meta">
                                    <p class="connection-name"><%= f.displayName || f.username %></p>
                                    <p class="connection-handle">@<%= f.username %></p>
                                </div>
                            </a>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <div class="social-widget-card">
                <div class="social-widget-header">
                    <h3>Following (<%= (user.followingUsers ? user.followingUsers.length : 0) + (user.followingArtists ? user.followingArtists.length : 0) %>)</h3>
                    <% let totalFollowing = (user.followingUsers ? user.followingUsers.length : 0) + (user.followingArtists ? user.followingArtists.length : 0); %>
                    <% if (totalFollowing > 3) { %>
                        <button class="toggle-expansion-btn" onclick="toggleSocialExpansion('followingList', this)">Show More</button>
                    <% } %>
                </div>
                <div class="social-connections-list" id="followingList">
                    <% if (totalFollowing === 0) { %>
                        <p class="empty-msg" style="font-size: 12px; text-align: left;">Not following anyone yet.</p>
                    <% } else { %>
                        <% let dynamicIndex = 0; %>
                        
                        <% if (user.followingUsers) { %>
                            <% user.followingUsers.forEach((u) => { %>
                                <a href="/api/users/<%= u._id %>/public" class="connection-row <%= dynamicIndex >= 3 ? 'collapsible-target' : '' %>">
                                    <img src="<%= u.profileImageUrl || '/Images/album-profile-images/epic.png' %>" class="connection-avatar">
                                    <div class="connection-meta">
                                        <p class="connection-name"><%= u.displayName || u.username %></p>
                                        <p class="connection-handle">@<%= u.username %></p>
                                    </div>
                                </a>
                                <% dynamicIndex++; %>
                            <% }) %>
                        <% } %>

                        <% if (user.followingArtists) { %>
                            <% user.followingArtists.forEach((a) => { %>
                                <a href="/artistProfile.html?id=<%= a._id %>" class="connection-row <%= dynamicIndex >= 3 ? 'collapsible-target' : '' %>">
                                    <img src="<%= a.image || '/Images/default-avatar.png' %>" class="connection-avatar">
                                    <div class="connection-meta">
                                        <p class="connection-name"><%= a.name %></p>
                                        <p class="connection-handle" style="color: #e74c3c;">🎵 Artist</p>
                                    </div>
                                </a>
                                <% dynamicIndex++; %>
                            <% }) %>
                        <% } %>
                    <% } %>
                </div>
            </div>

        </div>

    </div>

    <div class="modal" id="playlistModal">
        <div class="modal-content">
            <h3 id="modalTitle">Create Playlist</h3>
            <input type="text" id="playlistName" placeholder="Playlist name" maxlength="100">
            <textarea id="playlistDesc" placeholder="Description (optional)" maxlength="300" rows="3"></textarea>
            <label class="checkbox-label">
                <input type="checkbox" id="playlistPublic" checked> Public
            </label>
            <div class="modal-buttons">
                <button id="savePlaylistBtn">Save</button>
                <button id="cancelPlaylistBtn" class="btn-secondary">Cancel</button>
            </div>
        </div>
    </div>

    <div class="modal" id="songsModal">
    <div class="modal-content">
        <i class="fa-solid fa-xmark close-modal" onclick="closeSongsModal()" style="cursor:pointer; float:right; font-size: 20px;"></i>
        
        <h3 id="songsModalTitle">Playlist Songs</h3>
        <div id="songsListContainer"></div>
        
        <div id="modalFooter" style="margin-top: 20px; display: flex; justify-content: space-between;">
            <i class="fa-solid fa-trash" id="deletePlaylistBtn" style="cursor:pointer; color: #e74c3c; font-size: 20px;"></i>
            <button onclick="closeSongsModal()" class="btn-secondary">Close</button>
        </div>
    </div>
    </div>

</div>

<script src="/JavaScript/toast.js"></script>
<script src="/JavaScript/profile.js"></script>

<script>



</script>
<div id="profileModal" class="profile-modal">
    <span class="close-modal" onclick="closeProfileModal()">&times;</span>

    <img
        class="modal-image"
        src="<%= user.profileImageUrl || '/Images/default-avatar.png' %>"
    >
</div>


<script>
function openProfileModal() {
    document.getElementById('profileModal').style.display = 'flex';
}

function closeProfileModal() {
    document.getElementById('profileModal').style.display = 'none';
}
</script>
<script src="/JavaScript/navbar.js"></script>

</body>
</html>