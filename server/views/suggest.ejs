<!DOCTYPE html>
<html lang="en">
<head>
  <title>Suggest Music</title>
  <link rel="stylesheet" href="/CSS/suggest.css" />
</head>
<body>

<%- include('partials/navbar') %>

<% if (flash) { %>
  <div class="popup" id="popup" style="display:block;">✅ Thank you for your suggestion!</div>
  <script>setTimeout(() => { document.getElementById('popup').style.display = 'none'; }, 3000);</script>
<% } else { %>
  <div class="popup" id="popup">✅ Thank you for your suggestion!</div>
<% } %>

<div class="container">

  <h1>Suggest Music</h1>
  <p class="subtitle">Know a song or album we're missing? Drop it here and we'll look into it.</p>

  <button class="btn-red" onclick="openForm()">♫ &nbsp; Submit a Suggestion</button>

  <div class="form-card" id="form-card">
    <h2>New Suggestion</h2>

    <form method="POST" action="/suggestions">
      <div class="form-group">
        <label>Type *</label>
        <div class="radio-group">
          <label><input type="radio" name="type" value="album" checked onclick="changeType('album')" /> Album</label>
          <label><input type="radio" name="type" value="song" onclick="changeType('song')" /> Song</label>
        </div>
      </div>

      <div class="form-group">
        <label>Title *</label>
        <input type="text" name="title" id="title" placeholder="Album title" required />
      </div>

      <div class="form-group">
        <label>Artist *</label>
        <input type="text" name="artist" id="artist" placeholder="Artist name" required />
      </div>

      <div class="two-col">
        <div class="form-group">
          <label>Release Year</label>
          <input type="number" name="year" id="releaseYear" placeholder="e.g. 2023" min="1900" max="2099" />
        </div>
        <div class="form-group">
          <label>Genre</label>
          <input type="text" name="genre" id="genre" placeholder="Pop, Jazz, Rock..." />
        </div>
      </div>

      <div class="form-group">
        <label id="link-label">Album Link</label>
        <input type="text" name="link" id="link-input" placeholder="e.g. Spotify, Anghami, SoundCloud" />
      </div>

      <div class="form-actions">
        <button type="submit" class="btn-red">Submit</button>
        <button type="button" class="btn-red" onclick="closeForm()">Cancel</button>
      </div>
    </form>
  </div>

  <h2 class="suggestions-title">Your Suggestions</h2>

  <div id="suggestions-container">
    <% if (suggestions.length === 0) { %>
      <p style="text-align:center;color:gray;">You haven't made any suggestions yet.</p>
    <% } %>
    <% suggestions.forEach(s => { %>
    <div class="suggestion-card">
      <div class="suggestion-header">
        <span class="suggestion-title"><strong><%= s.title %></strong> — <%= s.artist %></span>
        <span class="badge badge-<%= s.status %>"><%= s.status %></span>
      </div>
      <div class="suggestion-meta">
        <span><%= s.type.charAt(0).toUpperCase() + s.type.slice(1) %></span>
        <% if (s.year) { %><span> · <%= s.year %></span><% } %>
        <% if (s.genre) { %><span> · <%= s.genre %></span><% } %>
      </div>
    </div>
    <% }) %>
  </div>

</div>

<script>
function openForm() {
    document.getElementById('form-card').style.display = 'block';
}
function closeForm() {
    document.getElementById('form-card').style.display = 'none';
}
function changeType(type) {
    const titleInput = document.getElementById('title');
    const linkLabel = document.getElementById('link-label');
    titleInput.placeholder = type === 'album' ? 'Album title' : 'Song title';
    linkLabel.textContent = type === 'album' ? 'Album Link' : 'Song Link';
}
</script>
</body>
</html>
