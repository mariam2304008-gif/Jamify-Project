<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Admin Add – Jamify</title>
  <link rel="stylesheet" href="/CSS/navbar.css">
  <link rel="stylesheet" href="/CSS/adminadd.css" />
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container">
  <h1>Add Song / Album</h1>

  <% if (error) { %>
    <p style="color:#e74c3c; margin-bottom:12px;"><%= error %></p>
  <% } %>
  <% if (success) { %>
    <p style="color:green; margin-bottom:12px;">✅ Added successfully!</p>
  <% } %>

  <div class="admin-form">
    <form method="POST" action="/admin/add" enctype="multipart/form-data">

      <% if (prefill) { %>
        <input type="hidden" name="suggestionId" value="<%= prefill._id %>" />
      <% } %>

      <div class="form-row">
        <label>Type *</label>
        <div class="radio-group">
          <label><input type="radio" name="type" value="album" <%= (!prefill || prefill.type === 'album') ? 'checked' : '' %> onclick="updateForm('album')" /> Album</label>
          <label><input type="radio" name="type" value="song"  <%= (prefill && prefill.type === 'song') ? 'checked' : '' %> onclick="updateForm('song')" /> Song</label>
        </div>
      </div>

      <div class="form-row">
        <label>Title *</label>
        <input type="text" name="title" placeholder="Title" value="<%= prefill ? prefill.title : '' %>" required />
      </div>

      <div class="form-row">
        <label>Artist *</label>
        <input type="text" name="artist" placeholder="Artist name" value="<%= prefill ? prefill.artist : '' %>" required />
      </div>

      <div class="form-row two-col">
        <div>
          <label>Release Date</label>
          <input type="date" name="releaseDate" value="<%= prefill && prefill.year ? prefill.year + '-01-01' : '' %>" />
        </div>
        <div>
          <label>Genre</label>
          <input type="text" name="genre" placeholder="Pop, Jazz, R&B..." value="<%= prefill ? prefill.genre : '' %>" />
        </div>
      </div>

      <div class="form-row two-col">
        <div>
          <label>Spotify Link</label>
          <input type="text" name="spotifyLink" placeholder="https://open.spotify.com/..." value="<%= prefill ? prefill.link : '' %>" />
        </div>
        <div>
          <label>Anghami Link</label>
          <input type="text" name="anghamiLink" placeholder="https://play.anghami.com/..." />
        </div>
      </div>

      <div class="form-row" id="imageField">
        <label id="imageLabel"><%= (prefill && prefill.type === 'song') ? 'Song Cover Image (optional)' : 'Album Cover Image *' %></label>
        <input type="file" name="image" id="imageInput" accept="image/jpeg,image/png,image/gif,image/webp" <%= (!prefill || prefill.type === 'album') ? 'required' : '' %> />
        <small style="color:#888; display:block; margin-top:4px;">JPG, PNG, GIF or WebP — max 5 MB</small>
      </div>

      <button type="submit" class="btn-add">Add</button>
    </form>
  </div>
</div>

<script>
function updateForm(type) {
  const imageLabel = document.getElementById('imageLabel');
  const imageInput = document.getElementById('imageInput');
  if (type === 'song') {
    imageLabel.textContent = 'Song Cover Image (optional)';
    imageInput.removeAttribute('required');
  } else {
    imageLabel.textContent = 'Album Cover Image *';
    imageInput.setAttribute('required', 'required');
  }
}
</script>

</body>
</html>
