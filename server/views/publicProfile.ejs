<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= profileUser.displayName %> - Jamify Profile</title>
    <link rel="stylesheet" href="/CSS/profile.css">
    <link rel="stylesheet" href="/CSS/navbar.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.2.1/css/all.min.css">

</head>
<body>

<%- include('partials/navbar') %>

<div class="has-navbar">
    </div>

<div class="main-content">

    <div class="profile-card">

    <div class="profile-image-wrapper">

<img
    id="profileImg"
    src="<%= profileUser.profileImageUrl || '/Images/album-profile-images/epic.png' %>"
    class="profile-image"
    style="cursor:pointer;"
>

</div>
        <div class="profile-info">
            <h2 id="displayName"><%= profileUser.displayName %></h2>
            <p class="username" id="displayUsername">@<%= profileUser.username %></p>
            <p class="bio" id="displayBio"><%= profileUser.bio || "No bio yet." %></p>

            <div class="stats">
                <span id="statReviews"><%= reviewCount %> Reviews</span>
                <span id="statPlaylists"><%= playlistCount %> Playlists</span>
            </div>
            


<% if (currentUser) { %>

<button
    id="followBtn"
    data-user-id="<%= profileUser._id %>"
    data-following="<%= profileUser.followers && profileUser.followers.some(f => f._id.toString() === currentUser._id.toString()) %>"
    class="follow-btn"
>
    <%= profileUser.followers && profileUser.followers.some(f => f._id.toString() === currentUser._id.toString())
        ? 'Unfollow'
        : 'Follow'
    %>
</button>

<% } %>


            
            </div></div>
    

    <div class="profile-layout">
        
        <div class="profile-main-col">
            <div class="tabs">
                <button class="tab active" onclick="showTab('reviews', this)">Reviews</button>
                <button class="tab" onclick="showTab('playlists', this)">Playlists</button>
            </div>

            <div id="reviews" class="tab-content active">
                <div id="user-reviews-container">
                <% if (!reviews || reviews.length === 0) { %>
                    <p class="empty-msg">No reviews yet.</p>
                <% } else { %>
                    <% reviews.forEach(review => { %>
                        <div class="review-card">
                            <% if (review.albumID) { %>
                                <a href="/albums/<%= review.albumID._id %>">
                                    <img src="<%= review.albumID.coverImageUrl ? review.albumID.coverImageUrl : '/Images/default-album.png' %>" alt="album art">
                                </a>
                            <% } else if (review.songID) { %>
                                <a href="/songs/<%= review.songID._id %>">
                                    <img src="<%= review.songID.coverImageUrl || '/Images/album-profile-images/epic.png' %>" alt="song art">
                                </a>
                            <% } else { %>
                                <img src="/Images/default-album.png" alt="fallback art">
                            <% } %>

                            <div class="review-text">
                                <h3>
                                    <% if (review.albumID) { %>
                                        <span style="font-size: 12px; color: #1db954; text-transform: uppercase; display: block; font-weight: bold;">Album Review</span>
                                        <a href="/albums/<%= review.albumID._id %>"><%= review.albumID.title %></a>
                                    <% } else if (review.songID) { %>
                                        <span style="font-size: 12px; color: #1db954; text-transform: uppercase; display: block; font-weight: bold;">Song Review</span>
                                        <a href="/songs/<%= review.songID._id %>"><%= review.songID.title %></a>
                                    <% } else { %>
                                        Unknown Logged Asset
                                    <% } %>
                                </h3>

                                <p class="rating">
                                <% for(let i = 0; i < review.rating; i++) { %>
                                        <i class="fa-solid fa-star"></i>
                                    <% } %>
                                    <% for(let i = review.rating; i < 5; i++) { %>
                                        <i class="fa-regular fa-star" style="color: #ccc"></i>
                                    <% } %>
                                </p>
                                
                                <p><%= review.review %></p>
                                <small><%= new Date(review.date).toLocaleDateString() %> • <%= new Date(review.date).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'}) %></small>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
                </div>
            </div>

            <div id="playlists" class="tab-content">
                <div class="playlist-header">
                    <h3>Public Playlists</h3>
                </div>
                <div id="user-playlists-container">
                <% if (!playlists || playlists.length === 0) { %>
                    <p class="empty-msg">No public playlists available.</p>
                <% } else { %>
                    <% playlists.forEach(playlist => { %>
                        <div class="playlist-card" style="cursor:pointer;" onclick="openSongsModal('<%= playlist._id %>', '<%= playlist.name %>')">
                             <div class="playlist-info">
                            <h3><%= playlist.name %></h3>
                            <p class="playlist-desc"><%= playlist.description || 'No description' %></p>
                            <p class="playlist-meta"><%= playlist.songs ? playlist.songs.length : 0 %> Songs</p>
                            </div>
                        </div>
                    <% }) %>
                <% } %>
                </div>
            </div>
        </div>

        <div class="profile-side-col">
            
            <div class="social-widget-card">
                <div class="social-widget-header">
                    <h3>Followers (<%= profileUser.followers ? profileUser.followers.length : 0 %>)</h3>
                    <% if (profileUser.followers && profileUser.followers.length > 3) { %>
                        <button class="toggle-expansion-btn" onclick="toggleSocialExpansion('followersList', this)">Show More</button>
                    <% } %>
                </div>
                <div class="social-connections-list" id="followersList">
                    <% if (!profileUser.followers || profileUser.followers.length === 0) { %>
                        <p class="empty-msg" style="font-size: 12px; text-align: left;">No followers yet.</p>
                    <% } else { %>
                        <% profileUser.followers.forEach((f, index) => { %>
                            <a href="/api/users/<%= f._id %>/public" class="connection-row <%= index >= 3 ? 'collapsible-target' : '' %>">
                                <img src="<%= f.profileImageUrl || '/Images/album-profile-images/epic.png' %>" class="connection-avatar">
                                <div class="connection-meta">
                                    <p class="connection-name"><%= f.displayName || f.username %></p>
                                    <p class="connection-handle">@<%= f.username %></p>
                                </div>
                            </a>
                        <% }) %>
                    <% } %>
                </div>
            </div>

            <div class="social-widget-card">
                <div class="social-widget-header">
                    <h3>Following (<%= (profileUser.followingUsers ? profileUser.followingUsers.length : 0) + (profileUser.followingArtists ? profileUser.followingArtists.length : 0) %>)</h3>
                    <% let totalFollowing = (profileUser.followingUsers ? profileUser.followingUsers.length : 0) + (profileUser.followingArtists ? profileUser.followingArtists.length : 0); %>
                    <% if (totalFollowing > 3) { %>
                        <button class="toggle-expansion-btn" onclick="toggleSocialExpansion('followingList', this)">Show More</button>
                    <% } %>
                </div>
                <div class="social-connections-list" id="followingList">
                    <% if (totalFollowing === 0) { %>
                        <p class="empty-msg" style="font-size: 12px; text-align: left;">Not following anyone yet.</p>
                    <% } else { %>
                        <% let dynamicIndex = 0; %>
                        
                        <% if (profileUser.followingUsers) { %>
                            <% profileUser.followingUsers.forEach((u) => { %>
                                <a href="/api/users/<%= u._id %>/public" class="connection-row <%= dynamicIndex >= 3 ? 'collapsible-target' : '' %>">
                                    <img src="<%= u.profileImageUrl || '/Images/album-profile-images/epic.png' %>" class="connection-avatar">
                                    <div class="connection-meta">
                                        <p class="connection-name"><%= u.displayName || u.username %></p>
                                        <p class="connection-handle">@<%= u.username %></p>
                                    </div>
                                </a>
                                <% dynamicIndex++; %>
                            <% }) %>
                        <% } %>

                        <% if (profileUser.followingArtists) { %>
                            <% profileUser.followingArtists.forEach((a) => { %>
                                <a href="/artists/<%= a._id %>/profile" class="connection-row <%= dynamicIndex >= 3 ? 'collapsible-target' : '' %>">
                                    <img src="<%= a.image || '/Images/default-avatar.png' %>" class="connection-avatar">
                                    <div class="connection-meta">
                                        <p class="connection-name"><%= a.name %></p>
                                        <p class="connection-handle" style="color: #1db954;"> Artist</p>
                                    </div>
                                </a>
                                <% dynamicIndex++; %>
                            <% }) %>
                        <% } %>
                    <% } %>
                </div>
            </div>

        </div>

    </div>

</div>

<div class="modal" id="songsModal">
    <div class="modal-content">
        <i class="fa-solid fa-xmark modal-close-btn" onclick="closeSongsModal()"></i>
        <h3 id="modalTitle" class="modal-title"></h3>
        <div id="songsList" style="max-height:300px; overflow-y:auto; margin:15px 0; border-top:1px solid #eee; padding-top:10px;"></div>
    </div>
</div>
</div>
<script>

async function openSongsModal(playlistId, playlistName) {
    const modal = document.getElementById('songsModal');
    const songsList = document.getElementById('songsList');

    document.getElementById('modalTitle').textContent = playlistName;
    songsList.innerHTML = '<p style="color:#888; font-style:italic;">Loading...</p>';
    modal.style.display = 'flex';

    try {
        const response = await fetch(`/api/users/playlists/${playlistId}`);
        const result = await response.json();

        if (!result.success || !result.data) {
            songsList.innerHTML = '<p style="color:#e74c3c;">Error loading playlist.</p>';
            return;
        }

        const songs = result.data.songs || [];

        if (songs.length === 0) {
            songsList.innerHTML = '<p style="color:#888; font-style:italic;">No songs added.</p>';
            return;
        }

        songsList.innerHTML = '';
        songs.forEach(song => {
            const div = document.createElement('div');
            div.className = 'song-row';
            div.innerHTML = `
                <a href="/songs/${song._id}" style="display:flex; align-items:center; gap:12px; flex:1;">
                    <img src="${song.coverImageUrl || '/Images/album-profile-images/epic.png'}"
                         style="width:44px; height:44px; border-radius:6px; object-fit:cover; flex-shrink:0;">
                    <div>
                        <div style="font-weight:600; font-size:14px;">${escapeHtml(song.title)}</div>
                        <div style="font-size:12px; color:#888;">${escapeHtml(song.artists?.name || 'Unknown Artist')}</div>
                    </div>
                </a>
            `;
            songsList.appendChild(div);
        });

    } catch (err) {
        console.error('Fetch error:', err);
        songsList.innerHTML = '<p style="color:#e74c3c;">Error loading songs.</p>';
    }
}

function closeSongsModal() {
    document.getElementById('songsModal').style.display = 'none';
}

function escapeHtml(str) {
    const d = document.createElement('div');
    d.appendChild(document.createTextNode(str || ''));
    return d.innerHTML;
}
// Tab Switching Handler for Public Profile
function showTab(tabId, btn) {
    document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
    document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
    document.getElementById(tabId).classList.add('active');
    if (btn) btn.classList.add('active');
}

// Collapsible Widget Engine for Following/Followers lists
function toggleSocialExpansion(listId, buttonElement) {
    const listContainer = document.getElementById(listId);
    listContainer.classList.toggle('expanded-state');
    if (listContainer.classList.contains('expanded-state')) {
        buttonElement.textContent = "Show Less";
    } else {
        buttonElement.textContent = "Show More";
    }
}
const followBtn = document.getElementById('followBtn');

if (followBtn) {

    followBtn.addEventListener('click', async () => {

        const userId = followBtn.dataset.userId;
        const isFollowing = followBtn.dataset.following === 'true';

        try {

            const endpoint = isFollowing
                ? `/api/users/${userId}/unfollow`
                : `/api/users/${userId}/follow`;

            const response = await fetch(endpoint, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                }
            });

            const data = await response.json();

            if (data.success) {

                followBtn.dataset.following = (!isFollowing).toString();

                followBtn.textContent = isFollowing
                    ? 'Follow'
                    : 'Unfollow';

                location.reload();

            } else {
                showToast(data.message || 'Something went wrong', 'error');
            }

        } catch (err) {
            console.error(err);
            showToast('Server error', 'error');
        }

    });

}
</script>
<script src="/JavaScript/toast.js"></script>
<script src="/JavaScript/navbar.js"></script>
<script>
document.getElementById('profileImg').addEventListener('click', function () {

    const overlay = document.createElement('div');

    overlay.innerHTML = `
        <div id="imageOverlay" style="
            position: fixed;
            inset: 0;
            background: rgba(0,0,0,0.9);
            display:flex;
            justify-content:center;
            align-items:center;
            z-index:9999;
        ">
            <span id="closeOverlay" style="
                position:absolute;
                top:20px;
                right:30px;
                font-size:40px;
                color:white;
                cursor:pointer;
            ">
                &times;
            </span>

            <img
                src="${this.src}"
                style="
                    max-width:80%;
                    max-height:80%;
                    border-radius:12px;
                "
            >
        </div>
    `;

    document.body.appendChild(overlay);

    document.getElementById('closeOverlay')
        .addEventListener('click', () => {
            overlay.remove();
        });

    overlay.addEventListener('click', (e) => {
        if (e.target.id === 'imageOverlay') {
            overlay.remove();
        }
    });

});
</script>
</body>
</html>