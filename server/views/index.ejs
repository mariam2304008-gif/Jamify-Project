<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Jamify - Rate the Music You Love</title>
  <link rel="stylesheet" href="/CSS/index.css">
  <link rel="stylesheet" href="/CSS/navbar.css" />
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
</head>
<body>

  <%- include('partials/navbar') %>

  <div class="has-navbar"></div>

  <div class="container">
    <h1>Rate. Review. Share.</h1>
    <p class="subtitle">Jamify is a simple music rating app where you can review albums, like reviews, and suggest new music to add.</p>

    <div class="container">
      <h1>Discover New Music</h1>
      <p class="subtitle">Trending reviews and top-rated albums on Jamify.</p>

      <% genres.forEach(genre => { %>
        <% if (albumsByGenre[genre] && albumsByGenre[genre].length > 0) { %>

          <h2 class="section-title"><%= genre %></h2>

          <div class="genre-carousel" data-genre="albums-<%= genre.toLowerCase().replace(/[^a-z0-9]/g, '-') %>">
            <button class="carousel-btn carousel-prev" aria-label="Previous">&#8592;</button>

            <div class="carousel-track-wrapper">
              <div class="carousel-track">
                <% albumsByGenre[genre].forEach(album => { %>
                  <div class="album-card">
                    <a href="/albums/<%= album._id %>" class="album-image-wrapper">
                      <img src="<%= album.coverImageUrl %>" alt="<%= album.title %>">
                      <span class="avg-rating"><i class="fa-solid fa-star"></i> <%= album.rating || 1 %></span>
                    </a>
                    <div class="album-card-info">
                      <h3><%= album.title %></h3>
                      <% if (album.artist && album.artist.name) { %>
                        <a href="/artists/<%= album.artist._id %>/profile"><%= album.artist.name %></a>
                      <% } else { %>
                        <p><%= album.artist %></p>
                      <% } %>
                    </div>
                  </div>
                <% }) %>
              </div>
            </div>

            <button class="carousel-btn carousel-next" aria-label="Next">&#8594;</button>
          </div>

        <% } %>
      <% }) %>


      <h2 class="section-title" style="margin-top: 50px;">Standalone Singles</h2>

      <% genres.forEach(genre => { %>
        <% if (songsByGenre[genre] && songsByGenre[genre].length > 0) { %>

          <h3 class="section-subtitle"><%= genre %></h3>

          <div class="genre-carousel" data-genre="songs-<%= genre.toLowerCase().replace(/[^a-z0-9]/g, '-') %>">
            <button class="carousel-btn carousel-prev" aria-label="Previous">&#8592;</button>

            <div class="carousel-track-wrapper">
              <div class="carousel-track">
                <% songsByGenre[genre].forEach(song => { %>
                  <a href="/songs/<%= song._id %>" class="album-card">
                    <div class="album-image-wrapper">
                      <img src="<%= song.coverImageUrl || '/Images/album-profile-images/default-single.png' %>" alt="<%= song.title %>">
                      <span class="avg-rating"><i class="fa-solid fa-star"></i> <%= song.rating || 1 %></span>
                    </div>
                    <div class="album-card-info">
                      <h3><%= song.title %></h3>
                      <p><%= song.artists?.name || 'Unknown Artist' %></p>
                    </div>
                  </a>
                <% }) %>
              </div>
            </div>

            <button class="carousel-btn carousel-next" aria-label="Next">&#8594;</button>
          </div>

        <% } %>
      <% }) %>

      <% const hasNoSongs = genres.every(g => !songsByGenre[g] || songsByGenre[g].length === 0); %>
      <% if (hasNoSongs) { %>
        <p style="color: grey; padding-left: 15px;">No standalone singles available right now.</p>
      <% } %>

    </div>
  </div>

  <script src="/JavaScript/navbar.js"></script>
<script src="/JavaScript/carousel.js"></script>
</body>
</html>