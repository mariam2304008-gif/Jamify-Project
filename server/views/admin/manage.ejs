<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Manage – Jamify</title>
  <link rel="stylesheet" href="/CSS/navbar.css">
  <link rel="stylesheet" href="/CSS/adminmanage.css" />

  <style>
      a[href="/admin/reviews"],
      .nav-links a[href="/admin/reviews"],
      nav a[href="/admin/reviews"] {
          display: none !important;
      }
  </style>
</head>
<body>

<%- include('../partials/navbar') %>

<div class="container">
  <h1>Admin Dashboard</h1>
  <div class="admin-dashboard-actions">
    <a href="/admin/manage" class="dashboard-card active">Manage Music</a>
    <a href="/admin/suggestions" class="dashboard-card">Review Suggestions</a>
    <a href="/admin/add" class="dashboard-card">Add Music</a>
    <a href="/admin/reviews" class="dashboard-card">Review Moderation</a>
  </div>

  <h2>Manage Music</h2>
  <% if (typeof albums !== 'undefined' && albums.length === 0) { %>
    <p class="empty">No albums found.</p>
  <% } else if (typeof albums !== 'undefined') { %>
    <% albums.forEach(a => { %>
    <div class="music-card">
      <a href="/albums/<%= a._id %>">
        <img src="<%= a.coverImageUrl %>" alt="<%= a.title %>" class="music-thumb" style="cursor: pointer; border-radius: 4px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
      </a>
      <div class="music-info">
        <strong><%= a.title %></strong>
        <span><%= a.artist %></span>
      </div>
      <div class="music-actions">
        <a href="/admin/edit/album/<%= a._id %>" class="btn-edit">Edit</a>
        <form method="POST" action="/admin/delete/album/<%= a._id %>" style="display:inline;" onsubmit="return confirm('Delete this album?')">
          <button type="submit" class="btn-delete">Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  <% } %>

  <h2 style="margin-top:40px;">Songs</h2>
  <% if (typeof songs !== 'undefined' && songs.length === 0) { %>
    <p class="empty">No songs found.</p>
  <% } else if (typeof songs !== 'undefined') { %>
    <% songs.forEach(s => { %>
    <div class="music-card">
      <a href="/songs/<%= s._id %>">
        <img src="<%= s.coverImageUrl || '/Images/album-profile-images/epic.png' %>" alt="<%= s.title %>" class="music-thumb" style="cursor: pointer; border-radius: 4px; transition: transform 0.2s;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" />
      </a>
      <div class="music-info">
        <strong><%= s.title %></strong>
        <span><%= Array.isArray(s.artists) ? s.artists.join(', ') : '' %></span>
      </div>
      <div class="music-actions">
        <a href="/admin/edit/song/<%= s._id %>" class="btn-edit">Edit</a>
        <form method="POST" action="/admin/delete/song/<%= s._id %>" style="display:inline;" onsubmit="return confirm('Delete this song?')">
          <button type="submit" class="btn-delete">Delete</button>
        </form>
      </div>
    </div>
    <% }) %>
  <% } %>
</div>

</body>
</html>